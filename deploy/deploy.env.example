# Server-side settings for deploy/deploy.sh. Copy to deploy/deploy.env on the
# server and fill in. This file configures the *deployment*; the application's
# own settings live in the repo-root .env (see deploy/env.production.example).
#
#   cp deploy/deploy.env.example deploy/deploy.env

# Public hostname of the API. Must have a DNS A record pointing at this server
# before `deploy.sh domain` can issue a certificate for it.
DOMAIN=api.wadielsafar.com

# Where Let's Encrypt sends expiry warnings. Required for certificate issuance.
LETSENCRYPT_EMAIL=ops@wadielsafar.com

# Host directory for state that must survive a rebuild: uploaded media,
# collected static files, database dumps. Bind-mounted into the containers.
DATA_DIR=/srv/wadielsafar

# Branch `deploy.sh update` fast-forwards to.
GIT_BRANCH=main

# Loopback port gunicorn is published on (nginx proxies to it).
WEB_PORT=8000

# gunicorn sizing — a common starting point is (2 x CPU cores) + 1.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=2

# nginx request limits.
MAX_BODY=50m
PROXY_TIMEOUT=60
