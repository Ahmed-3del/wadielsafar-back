# Production values for the repo-root .env. `deploy.sh init` generates this
# file automatically (with fresh secrets) if .env does not exist yet; this copy
# documents what it writes.
#
# Read twice by design: django-environ reads it via environ.Env.read_env(), and
# docker compose loads it as env_file / --env-file.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=__GENERATED__
DJANGO_DEBUG=False

# 127.0.0.1 and localhost must stay in the list: deploy.sh and the container
# HEALTHCHECK probe gunicorn directly on loopback, and Django rejects any Host
# header that is not listed.
DJANGO_ALLOWED_HOSTS=api.wadielsafar.com,localhost,127.0.0.1

# Host names are compose service names, not localhost — these resolve on the
# compose network. POSTGRES_* below must stay in sync with this URL; deploy.sh
# validates that on every run.
DATABASE_URL=postgres://wadi:__GENERATED__@postgres:5432/wadi_elsafar
REDIS_URL=redis://redis:6379/0

POSTGRES_DB=wadi_elsafar
POSTGRES_USER=wadi
POSTGRES_PASSWORD=__GENERATED__

# Every browser origin that calls this API. Scheme + host + port, no trailing
# slash. The refresh-token cookie flow needs these exact (credentialed
# requests reject a wildcard origin).
CORS_ALLOWED_ORIGINS=https://wadielsafar.com,https://www.wadielsafar.com,https://panel.wadielsafar.com

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

SENTRY_DSN=

# Consumed by docker compose, not by Django.
DATA_DIR=/srv/wadielsafar
WEB_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=2
